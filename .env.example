# Optional but recommended. A fine-grained token with public repository read
# access is enough. Without it GitHub allows 60 requests/hour per IP.
GITHUB_TOKEN=

# Express server port
PORT=5000

# Allowed browser origin during development
CLIENT_ORIGIN=http://localhost:5173

# Optional. Override the GitHub API base (useful for GitHub Enterprise or a
# local mock during development). Defaults to https://api.github.com.
# GITHUB_API_BASE=http://localhost:4000
